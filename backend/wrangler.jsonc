{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notes-app-using-react",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": { "NODE_ENV": "production" }
}